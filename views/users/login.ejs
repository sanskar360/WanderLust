<% layout("/layouts/boilerPlate") -%>
<body>
    <br><br>

    <div class="row">
        <div class="col-6 offset-2 mb-6"><h2>Login on Wanderlust</h2></div>
        <div class="col-8 offset-2">
            <form action="/login" method="POST" novalidate class="needs-validation">
                <div class="mb-5">
                    <label for="username" class="form-label">Username</label>
                    <input
                        name="username"
                        id="username"
                        type="text"
                        class="form-control"
                        required
                    >
                </div>
                <div class="mb-5">
                    <label for="password" class="form-label">Password</label>
                    <input
                        name="password"
                        id="password"
                        type="text"
                        class="form-control"
                        required
                    >
                </div>
                <button class="btn btn-success mb-5">Login</button>
            </form>
        </div>
    </div>